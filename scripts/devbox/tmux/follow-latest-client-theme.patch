 /*
+ * When terminals attached to the same session disagree about light and dark,
+ * panes follow the most recently used one (see window_latest_client); mark the
+ * session's panes so they are re-evaluated once this client becomes the most
+ * recent.
+ */
+static void
+server_client_theme_follow(struct client *c)
+{
+	struct session		*s = c->session;
+	struct client		*loop;
+	int			 differ = 0;
+
+	if (s == NULL || c->theme == THEME_UNKNOWN)
+		return;
+	TAILQ_FOREACH(loop, &clients, entry) {
+		if (loop == c || loop->session != s ||
+		    (loop->flags & CLIENT_UNATTACHEDFLAGS) ||
+		    loop->theme == THEME_UNKNOWN)
+			continue;
+		if (loop->theme != c->theme) {
+			differ = 1;
+			break;
+		}
+	}
+	if (differ)
+		session_theme_changed(s);
+}
