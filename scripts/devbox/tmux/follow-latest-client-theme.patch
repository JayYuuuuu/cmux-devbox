+/*
+ * Get the attached client showing this window that was used most recently,
+ * optionally only among clients with a known background, foreground or
+ * theme. When several terminals share a session their colours can differ;
+ * the one being typed in is the one the pane should match.
+ */
+#define WINDOW_LATEST_BG 0x1
+#define WINDOW_LATEST_FG 0x2
+#define WINDOW_LATEST_THEME 0x4
+static struct client *
+window_latest_client(struct window *w, int need)
 {
-	struct window	*w = wp->window;
-	struct client	*loop;
+	struct client	*loop, *found = NULL;
 
 	TAILQ_FOREACH(loop, &clients, entry) {
 		if (loop->flags & CLIENT_UNATTACHEDFLAGS)
 			continue;
 		if (loop->session == NULL || !session_has(loop->session, w))
 			continue;
-		if (loop->tty.bg == -1)
+		if ((need & WINDOW_LATEST_BG) && loop->tty.bg == -1)
+			continue;
+		if ((need & WINDOW_LATEST_FG) && loop->tty.fg == -1)
 			continue;
-		return (loop->tty.bg);
+		if ((need & WINDOW_LATEST_THEME) && loop->theme == THEME_UNKNOWN)
+			continue;
+		if (found == NULL ||
+		    timercmp(&loop->activity_time, &found->activity_time, >))
+			found = loop;
 	}
-	return (-1);
+	return (found);
+}
+
+/* Get a client with a background for the pane. */
+int
+window_get_bg_client(struct window_pane *wp)
+{
+	struct client	*c;
+
+	c = window_latest_client(wp->window, WINDOW_LATEST_BG);
+	return (c == NULL ? -1 : c->tty.bg);
 }
 
