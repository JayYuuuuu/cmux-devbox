@@ -877,8 +885,11 @@ input_init(struct window_pane *wp, struct bufferevent *bev,
     struct colour_palette *palette, struct client *c)
 {
 	struct input_ctx	*ictx;
+	u_int			 i;
 
 	ictx = xcalloc(1, sizeof *ictx);
