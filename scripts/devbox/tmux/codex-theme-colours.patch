+/* sRGB channel to linear and back. */
+static float
+colour_srgb_to_linear(u_char v)
+{
+	float	c = v / 255.0f;
+
+	if (c <= 0.04045f)
+		return (c / 12.92f);
+	return (powf((c + 0.055f) / 1.055f, 2.4f));
+}
+
+static u_char
+colour_linear_to_srgb(float c)
+{
+	if (c <= 0.0f)
+		return (0);
+	if (c >= 1.0f)
+		return (255);
+	if (c <= 0.0031308f)
+		c *= 12.92f;
+	else
+		c = 1.055f * powf(c, 1.0f / 2.4f) - 0.055f;
+	return ((u_char)lroundf(c * 255.0f));
+}
+
+/*
+ * Draw an RGB colour chosen for a dark (or light) page on a terminal of the
+ * given theme. If the kinds match, or the colour carries no kind, it is used
+ * as is. Otherwise its OKLab lightness is mirrored so it keeps the same
+ * distance from the page (pages taken as L 0.22 dark and 0.95 light), with
+ * hue and chroma kept: pale text for a dark page becomes dark text on a light
+ * one, and the other way round. The result has no kind flags.
+ */
+int
+colour_for_theme(int c, enum client_theme theme, int is_bg)
+{
+	static int	 last_in = -1, last_out;
+	static enum client_theme last_theme;
+	static int	 last_is_bg;
+	const float	 dark_page = 0.22f, light_page = 0.95f;
+	u_char		 r, g, b;
+	float		 lr, lg, lb, l, m, s, L, A, B, from, to;
+	int		 kind;
+
+	kind = c & COLOUR_FLAG_FOR_THEME;
+	c &= ~COLOUR_FLAG_FOR_THEME;
+	if (kind == 0 || (~c & COLOUR_FLAG_RGB) || theme == THEME_UNKNOWN)
+		return (c);
+	if ((kind == COLOUR_FLAG_FOR_DARK && theme == THEME_DARK) ||
+	    (kind == COLOUR_FLAG_FOR_LIGHT && theme == THEME_LIGHT))
+		return (c);
+	if (c == last_in && theme == last_theme && is_bg == last_is_bg)
+		return (last_out);
+
+	colour_split_rgb(c, &r, &g, &b);
+	lr = colour_srgb_to_linear(r);
+	lg = colour_srgb_to_linear(g);
+	lb = colour_srgb_to_linear(b);
+	l = cbrtf(0.4122214708f * lr + 0.5363325363f * lg + 0.0514459929f * lb);
+	m = cbrtf(0.2119034982f * lr + 0.6806995451f * lg + 0.1073969566f * lb);
+	s = cbrtf(0.0883024619f * lr + 0.2817188376f * lg + 0.6299787005f * lb);
+	L = 0.2104542553f * l + 0.7936177850f * m - 0.0040720468f * s;
+	A = 1.9779984951f * l - 2.4285922050f * m + 0.4505937099f * s;
+	B = 0.0259040371f * l + 0.7827717662f * m - 0.8086757660f * s;
+
+	from = (kind == COLOUR_FLAG_FOR_DARK) ? dark_page : light_page;
+	to = (theme == THEME_DARK) ? dark_page : light_page;
+	L = to + (from - L);
+	if (L < 0.0f)
+		L = 0.0f;
+	if (L > 1.0f)
+		L = 1.0f;
+
+	l = L + 0.3963377774f * A + 0.2158037573f * B;
+	m = L - 0.1055613458f * A - 0.0638541728f * B;
+	s = L - 0.0894841775f * A - 1.2914855480f * B;
+	l = l * l * l;
+	m = m * m * m;
+	s = s * s * s;
+	r = colour_linear_to_srgb(4.0767416621f * l - 3.3077115913f * m +
+	    0.2309699292f * s);
+	g = colour_linear_to_srgb(-1.2684380046f * l + 2.6097574011f * m -
+	    0.3413193965f * s);
+	b = colour_linear_to_srgb(-0.0041960863f * l - 0.7034186147f * m +
+	    1.7076147010f * s);
+
+	last_in = c;
+	last_theme = theme;
+	last_is_bg = is_bg;
+	last_out = colour_join_rgb(r, g, b);
+	return (last_out);
+}
